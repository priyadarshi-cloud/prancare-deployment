# PranCare Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.

# Google Gemini API Key (server-side only, for packaging OCR & supply advisory)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database URL (local dev.db; on Vercel automatically uses /tmp/prancare.db)
DATABASE_URL=file:./dev.db

# Demo Mode: enables synthetic demo samples, supply data, and fallback mock OCR
DEMO_MODE=true

# Privacy Threshold: k-anonymity minimum scan count per geographic cell
MIN_CELL_COUNT=5

# Optional Map Tile Provider Key (Leaflet + OpenStreetMap default requires none)
MAP_API_KEY=

# Local Server Port
PORT=3000
